# Скопируй этот файл в .env и заполни своими значениями из Supabase
# (Project Settings -> Database -> Connection string, и Project Settings -> API).

# Connection string к базе (используй "Connection pooling" / URI, режим Session или Transaction)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[HOST]:5432/postgres"

# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxxxxx"
