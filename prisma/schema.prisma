// Real database schema, backed by Supabase Postgres.
// Wired into the app via src/lib/db/venues.ts and the admin panel
// under src/app/admin/**.
//
// Setup (see README.md "Админ-панель и база данных"):
//   1. npm install
//   2. Put your Supabase connection strings in .env as DATABASE_URL
//      (pooled, "Transaction", with &pgbouncer=true) and DIRECT_URL
//      (non-pooled, "Session"/"Direct connection") — see the datasource
//      block below for why both are needed — plus
//      NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
//   3. npx prisma migrate dev --name init
//   4. npx prisma db seed   (loads the venues.ts demo data into Postgres)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // DATABASE_URL — обычная строка подключения (через PgBouncer/Supavisor,
  // с &pgbouncer=true) — ей пользуется работающее приложение.
  // DIRECT_URL — отдельная НЕ-пуловая строка подключения (порт 5432 в
  // Supabase, без pgbouncer=true) — нужна только для `prisma migrate`,
  // потому что миграциям нужны advisory locks, которые PgBouncer в
  // transaction-режиме не поддерживает. Обе строки берутся в Supabase на
  // вкладке Project Settings → Database → Connection string (первая —
  // "Transaction", вторая — "Session"/"Direct connection").
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  venues    Venue[]
  staff     StaffMember[]
}

model Venue {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  slug       String         @unique
  nameKa     String
  nameRu     String
  nameEn     String
  addressKa  String
  addressRu  String
  addressEn  String
  brandColor String         @default("#c0392b")
  categories MenuCategory[]
  tables     Table[]
  staff      StaffMember[]
  ingredients Ingredient[]
  orders     Order[]
  // Ссылки на страницу этой точки на агрегаторах доставки — просто
  // хранятся и открываются кнопкой в админке, автоматического обновления
  // цен/наличия на этих платформах отсюда нет (нет доступа к их API).
  urlWolt    String?
  urlBolt    String?
  urlGlovo   String?
  urlFacebook  String?
  urlInstagram String?
  urlMaps      String?
  // Ссылка на форму отзыва этой точки в Google (Google Maps "написать
  // отзыв") — когда задана, гостю после успешного заказа мягко
  // предлагается оставить отзыв по этой ссылке.
  urlGoogleReview String?
  waiterCalls  WaiterCall[]
  // Свободный текст про бренд/точку (когда и где создан бренд, когда и
  // где открылись, история и т.п.) — заполняется вручную оператором,
  // ИИ-помощник читает это, чтобы отвечать на вопросы про историю заведения.
  aboutText  String?
}

model MenuCategory {
  id        String     @id @default(cuid())
  venueId   String
  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  slug      String
  nameKa    String
  nameRu    String
  nameEn    String
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id            String       @id @default(cuid())
  categoryId    String
  category      MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug          String
  nameKa        String
  nameRu        String
  nameEn        String
  descriptionKa String       @default("")
  descriptionRu String       @default("")
  descriptionEn String       @default("")
  // Базовая цена — одна и та же на сайте, в ресторане и на всех
  // агрегаторах. Разница между площадками — это только скидка (%),
  // заданная отдельно ниже; финальная цена на площадке считается как
  // priceGel * (1 - discount/100).
  priceGel      Decimal
  // Скидка/наценка (%) на самом гостевом QR-меню (в ресторане) — когда
  // задана, на гостевой странице показывается перечёркнутая базовая цена
  // и рядом цена со скидкой, посчитанная так же: priceGel * (1 - %/100).
  discountMenuPercent  Decimal?
  discountWoltPercent  Decimal?
  discountBoltPercent  Decimal?
  discountGlovoPercent Decimal?
  available     Boolean      @default(true)
  photoUrl      String?
  sortOrder     Int          @default(0)
  recipeItems   RecipeItem[]
  orderItems    OrderItem[]
  modifierGroups ModifierGroup[]
}

// Группа платных опций у блюда — например "Соус" (выбрать одну) или
// "Дополнительно" (выбрать до нескольких). Гость выбирает их в гостевом
// меню перед добавлением блюда в корзину; выбор влияет на итоговую цену
// строки заказа (см. ModifierOption.priceGel и OrderItem.modifiersSnapshot).
model ModifierGroup {
  id            String           @id @default(cuid())
  menuItemId    String
  menuItem      MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  nameKa        String
  nameRu        String
  nameEn        String
  // "SINGLE" — радио-кнопки, ровно один выбор (например "Соус", "Размер").
  // "MULTIPLE" — чекбоксы, до maxSelect штук (например "Допы").
  selectionType String           @default("SINGLE")
  maxSelect     Int              @default(1) // используется только при selectionType = "MULTIPLE"
  sortOrder     Int              @default(0)
  options       ModifierOption[]
}

model ModifierOption {
  id        String        @id @default(cuid())
  groupId   String
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  nameKa    String
  nameRu    String
  nameEn    String
  priceGel  Decimal       @default(0)
  sortOrder Int           @default(0)
}

// Ингредиент точки (своя база у каждого Venue) — название, единица
// измерения, цена за единицу и флаг "в наличии". Используется для
// расчёта себестоимости блюд и для автоматического отключения блюд,
// у которых закончился хотя бы один ингредиент из состава.
model Ingredient {
  id           String       @id @default(cuid())
  venueId      String
  venue        Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name         String
  // Название на конкретном языке — необязательные, чтобы не требовать
  // миграцию данных: пока не заполнены, интерфейс показывает старое
  // единое поле name как запасной вариант.
  nameKa       String?
  nameRu       String?
  nameEn       String?
  unit         String       // "г", "кг", "мл", "л", "шт" и т.п.
  pricePerUnit Decimal
  available    Boolean      @default(true)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  recipeItems  RecipeItem[]
}

// Строка состава блюда: сколько единиц ингредиента уходит на одну
// порцию. Себестоимость блюда = сумма (quantity * ingredient.pricePerUnit)
// по всем строкам его состава.
model RecipeItem {
  id           String     @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Decimal
  sortOrder    Int        @default(0)
}

model Table {
  id          String       @id @default(cuid())
  venueId     String
  venue       Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  label       String       // e.g. "Table 5", printed on the QR code
  createdAt   DateTime     @default(now())
  orders      Order[]
  waiterCalls WaiterCall[]
}

// Вызов официанта гостем со страницы меню (виден только когда меню
// открыто по ссылке конкретного стола — см. ?table=<id>). status "NEW"
// означает, что персонал ещё не отреагировал; отображается на общей
// доске заказов /admin/[venueSlug]/orders вместе с заказами.
model WaiterCall {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tableId   String
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  reason    String
  status    String   @default("NEW") // "NEW" | "DONE"
  createdAt DateTime @default(now())
}

// STEP 2 — реальные заказы (вместо демо-заглушки в /api/orders).
// orderNumber — сквозной номер, но СВОЙ У КАЖДОГО VENUE (не общий на всю
// платформу): у ресторана A заказ №1 и у ресторана B заказ №1 — это два
// разных заказа. Гарантируется уникальностью [venueId, orderNumber] ниже;
// сам номер присваивается в транзакции в /api/orders.
model Order {
  id          String      @id @default(cuid())
  venueId     String
  venue       Venue       @relation(fields: [venueId], references: [id])
  orderNumber Int
  // NEW → IN_PROGRESS → READY → DONE, либо CANCELLED в любой момент.
  status      String      @default("NEW")
  locale      String
  tableId     String?
  table       Table?      @relation(fields: [tableId], references: [id])
  totalGel    Decimal
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([venueId, orderNumber])
}

// Снимок блюда на момент заказа: имя и цена сохраняются такими, какими
// были при оформлении, даже если позже блюдо в меню переименуют, удалят
// или изменят цену/скидку — старый заказ не должен "поехать" задним числом.
model OrderItem {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId   String?
  menuItem     MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  nameSnapshot String
  priceGel     Decimal
  qty          Int
  // Выбранные платные опции на момент заказа — снимок вида
  // [{ groupName, optionName, priceGel }], независимый от последующих
  // правок ModifierGroup/ModifierOption у самого блюда.
  modifiersSnapshot Json?
}

// Links a Supabase Auth user (by their auth.users id) to a tenant/venue
// so the admin panel knows who's allowed in and what they can edit.
// role "OWNER" can edit every venue under the tenant; "STAFF" is scoped
// to a single venue (venueId set).
model StaffMember {
  id             String   @id @default(cuid())
  supabaseUserId String   @unique
  email          String
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  venueId        String?
  venue          Venue?   @relation(fields: [venueId], references: [id])
  role           String   @default("OWNER") // "OWNER" | "STAFF"
  createdAt      DateTime @default(now())
}
